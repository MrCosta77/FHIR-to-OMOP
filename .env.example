# Select one versioned profile: development, benchmark or hospital.
CMF_PROFILE=development
# Hospital profile only: inject these through the institution's secret manager.
# CMF_PHI_SALT=<institution-managed-secret-with-at-least-32-characters>
# CMF_PHI_KEY_VERSION=<institution-managed-key-version>

# Optional overrides. Relative paths are resolved from the repository root.
# CMF_DB_PATH=data/omop_clinical.duckdb
# CMF_FHIR_DIR=synthea/output/fhir
# CMF_VOCAB_DIR=data/omop_vocab
# CMF_CHROMA_PATH=data/chroma_db
# CMF_RUNS_DIR=data/runs
# CMF_MANIFESTS_DIR=data/run_manifests
# CMF_REPORTS_DIR=data/run_reports
# CMF_DQD_RESULTS_DIR=dqd_results

# The endpoint must remain on loopback; external LLM endpoints fail closed.
# CMF_OLLAMA_URL=http://localhost:11434/api/generate
# CMF_MODEL_NAME=qwen2.5-coder:7b
# CMF_SIMILARITY_THRESHOLD=0.90
# CMF_DATA_CLASSIFICATION=SYNTHETIC
# CMF_SIMULATE_LIS_NOISE=false
# CMF_REQUIRE_INTEGRATION=false
# CMF_INCLUDE_DQD=false

# PHI activation is intentionally incomplete here. Never commit real identities.
# CMF_PHI_ENABLED=true
# CMF_PHI_POLICY_APPROVED_BY=<institutional-approver>
# CMF_PHI_RETENTION_DAYS=<positive-integer>
# CMF_AUTHENTICATED_USER=<authenticated-user>
# CMF_REVIEWER_ALLOWLIST=<comma-separated-reviewers>
# CMF_ADJUDICATOR_ALLOWLIST=<comma-separated-adjudicators>
# CMF_SOURCE_ADMIN_ALLOWLIST=<comma-separated-source-administrators>
