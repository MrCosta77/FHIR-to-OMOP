{
    "schema_version": "1.0.0",
    "profile": "development",
    "defaults": {
        "db_path": "data/omop_clinical.duckdb",
        "fhir_dir": "synthea/output/fhir",
        "vocab_dir": "data/omop_vocab",
        "chroma_path": "data/chroma_db",
        "runs_dir": "data/runs",
        "manifests_dir": "data/run_manifests",
        "reports_dir": "data/run_reports",
        "dqd_results_dir": "dqd_results",
        "ollama_url": "http://localhost:11434/api/generate",
        "model_name": "qwen2.5-coder:7b",
        "similarity_threshold": 0.9,
        "proposal_review_threshold": 0.8,
        "data_classification": "SYNTHETIC",
        "simulate_lis_noise": false,
        "require_integration": false,
        "include_dqd": false,
        "ollama_timeout": 120.0,
        "cdm_source_name": "Clinical Mapping Framework (Synthea RWE)",
        "cdm_source_abbreviation": "CMF-Synthea",
        "cdm_holder": "M\u00c3\u00a1rio Lu\u00c3\u00ads Gon\u00c3\u00a7alves da Costa",
        "cdm_source_description": "Synthetic patient records generated via Synthea and transformed into OMOP CDM.",
        "cdm_source_release_date": "",
        "cdm_source_documentation_reference": "https://github.com/synthetichealth/synthea",
        "cdm_etl_reference": "https://github.com/MrCosta77/FHIR-to-OMOP",
        "lis_noise_ratio": 0.1
    }
}
